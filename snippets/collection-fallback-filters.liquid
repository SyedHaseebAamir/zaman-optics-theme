{% doc %}
  Tag filters only where the equivalent native Shopify filter is not configured.
  Contact-lens collections use their own attribute groups.
  @param current_tags - The collection's active tags.
  @param {boolean} [hide_shape] - Native shape filter exists.
  @param {boolean} [hide_material] - Native material filter exists.
  @param {boolean} [hide_gender] - Native gender filter exists.
  @param {boolean} [hide_size] - Native size filter exists.
  @param {boolean} [show_price] - Legacy argument; native price filters are required.
{% enddoc %}
{% liquid
  assign groups = 'Shape:|Frame shape|filter.p.m.custom.frame_shape,Material:|Material|filter.p.m.custom.material,Gender:|Gender|filter.p.m.custom.gender,Size:|Size|filter.p.m.custom.size' | split: ','
  if collection.handle contains 'contact' or collection.handle contains 'lens-care'
    assign groups = 'Brand:|Brand|filter.p.vendor,LensType:|Lens type|filter.p.m.custom.lens_type,Replacement:|Replacement schedule|filter.p.m.custom.replacement_schedule,Color:|Colour|filter.v.option.color' | split: ','
  endif
%}
{% for group in groups %}
  {% liquid
    assign parts = group | split: '|'
    assign prefix = parts[0]
    assign native_exists = false
    for filter in collection.filters
      if filter.param_name == parts[2]
        assign native_exists = true
      endif
    endfor
    if prefix == 'Shape:' and hide_shape
      assign native_exists = true
    elsif prefix == 'Material:' and hide_material
      assign native_exists = true
    elsif prefix == 'Gender:' and hide_gender
      assign native_exists = true
    elsif prefix == 'Size:' and hide_size
      assign native_exists = true
    endif
  %}
  {% unless native_exists %}
    {% capture items %}
      {% for tag in collection.all_tags %}
        {% assign start = tag | slice: 0, prefix.size %}
        {% if start == prefix %}
          {% assign label = tag | remove_first: prefix | strip %}
          <li class="zcf-item"><label class="zcf-label">
            <input type="checkbox" class="zcf-cb zcf-tag-filter" data-tag-handle="{{ tag | handleize }}" {% if current_tags contains tag %}checked{% endif %}>
            <span class="zcf-text">{{ label | escape }}</span>
          </label></li>
        {% endif %}
      {% endfor %}
    {% endcapture %}
    {% assign items = items | strip %}
    {% if items != blank %}
      <details class="zcf-group" open><summary class="zcf-title"><span>{{ parts[1] }}</span><span class="zcf-chevron">{% render 'zaman-premium-icon', icon: 'chevron-down', size: 14 %}</span></summary><ul class="zcf-list">{{ items }}</ul></details>
    {% endif %}
  {% endunless %}
{% endfor %}
