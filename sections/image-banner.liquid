{% liquid
  assign primary_url = section.settings.btn_primary_url | default: routes.all_products_collection_url
  assign secondary_url = section.settings.btn_secondary_url | default: '/pages/lens-guide'
%}
<section class="zo-hero" aria-labelledby="ZoHeroTitle-{{ section.id }}">
  {% if section.settings.hero_image %}
    {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'zo-hero__image', widths: '750, 1100, 1500, 1800, 2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image.alt }}
  {% else %}
    <img src="{{ 'zaman-daylight-eyewear.png' | asset_url }}" alt="" class="zo-hero__image" width="1774" height="887" fetchpriority="high">
  {% endif %}
  <div class="zo-container zo-hero__content">
    <p class="zo-eyebrow">{{ section.settings.hero_label | escape }}</p>
    <h1 id="ZoHeroTitle-{{ section.id }}">{{ section.settings.hero_headline | escape }}</h1>
    <p class="zo-hero__copy">{{ section.settings.hero_subtext | escape }}</p>
    <div class="zo-actions">
      {% if section.settings.btn_primary_text != blank %}<a class="zo-button" href="{{ primary_url }}">{{ section.settings.btn_primary_text | escape }} {% render 'zaman-premium-icon', icon: 'arrow-right', size: 16 %}</a>{% endif %}
      {% if section.settings.btn_secondary_text != blank %}<a class="zo-button zo-button--secondary" href="{{ secondary_url }}">{{ section.settings.btn_secondary_text | escape }}</a>{% endif %}
    </div>
    <p class="zo-hero__note">Frames for you. Guidance from a local optical team.</p>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "hero_label",
      "label": "Small label above headline",
      "default": "LOCAL OPTICAL CARE, ONLINE"
    },
    {
      "type": "textarea",
      "id": "hero_headline",
      "label": "Main Headline",
      "default": "Glasses that fit your life."
    },
    {
      "type": "textarea",
      "id": "hero_subtext",
      "label": "Subheadline",
      "default": "Discover everyday frames, sunglasses, blue screen glasses, and prescription-ready options with support from our Gujar Khan team."
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "Shop eyeglasses"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_secondary_text",
      "label": "Secondary Button Text",
      "default": "Explore sunglasses"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust Badge 1",
      "default": "Prescription support"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust Badge 2",
      "default": "Online payments available"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust Badge 3",
      "default": "Delivery across Pakistan"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ]
}
{% endschema %}
