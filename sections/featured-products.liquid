{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank and section.settings.collection_handle != blank
    assign featured_collection = collections[section.settings.collection_handle]
  endif
  if featured_collection == blank and section.settings.collection_handle == blank
    assign featured_collection = collections.all
  endif
  assign collection_url = section.settings.view_all_link | default: featured_collection.url
%}
{% if featured_collection.products.size > 0 %}
<section class="zo-section zo-container">
  <div class="zo-section-heading">
    <div><p class="zo-eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.section_title | escape }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle | escape }}</p>{% endif %}</div>
    <a class="zo-text-link" href="{{ collection_url }}">View collection {% render 'zaman-premium-icon', icon: 'arrow-right', size: 16 %}</a>
  </div>
  <div class="zo-product-grid">
    {% for product in featured_collection.products limit: section.settings.products_to_show %}
      {% render 'zaman-product-card', card_product: product, show_secondary_image: true %}
    {% endfor %}
  </div>
</section>
{% elsif section.settings.show_empty %}
  <section class="zo-section zo-container">
    <div class="zo-section-heading"><div><p class="zo-eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.section_title | escape }}</h2><p>{{ section.settings.subtitle | escape }}</p></div></div>
    <div class="zo-collection-empty"><p>{{ section.settings.empty_text | escape }}</p><a class="zo-text-link" href="/pages/contact">Ask about availability {% render 'zaman-premium-icon', icon: 'arrow-right', size: 16 %}</a></div>
  </section>
{% elsif request.design_mode %}
  <div class="zo-container zo-section"><p>Select a collection with published products.</p></div>
{% endif %}

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"checkbox","id":"show_empty","label":"Show section before products are published","default":false},
    {"type":"text","id":"empty_text","label":"Availability message","default":"Our online selection is being prepared. Contact our team for current availability."},
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop the edit"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Featured Frames"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A focused selection of everyday eyewear with clear product details and prescription-ready options."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Fallback collection handle",
      "info": "Used only when no collection is selected above.",
      "default": "all"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View collection link",
      "info": "Optional custom URL. Leave blank to use the selected collection URL."
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "kicker": "Featured collection",
        "section_title": "Best Sellers",
        "subtitle": "A curated selection of frames and lenses customers choose most often.",
        "collection_handle": "all",
        "products_to_show": 8,
        "view_all_link": "/collections/all?sort_by=best-selling"
      }
    }
  ]
}
{% endschema %}
