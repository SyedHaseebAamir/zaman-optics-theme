{{ 'zaman-storefront.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zaman-storefront.js' | asset_url }}" defer></script>
<div class="zo-announcement"><div class="zo-container"><span>{{ section.settings.announcement | escape }}</span><a href="/pages/contact">Talk to our team {% render 'zaman-premium-icon', icon: 'arrow-right', size: 14 %}</a></div></div>
<header class="zo-header">
  <div class="zo-container zo-header__main">
    <button class="zo-icon-button" type="button" data-zo-open="ZoMenu" aria-label="Open menu" aria-controls="ZoMenu" aria-expanded="false" title="Menu">{% render 'zaman-premium-icon', icon: 'menu', size: 24 %}</button>
    <a class="zo-logo" href="{{ routes.root_url }}" aria-label="Zaman Optics home">
      {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 360 | image_tag: width: 180, loading: 'eager', alt: shop.name }}
      {% else %}{% render 'zaman-premium-icon', icon: 'glasses', size: 32 %}<span>Zaman Optics</span>{% endif %}
    </a>
    <nav class="zo-header__links" aria-label="Main navigation"><a href="{{ routes.collections_url }}">Collections</a><a href="{{ routes.all_products_collection_url }}">All Products</a><a href="/pages/contact">Contact</a></nav>
    <form action="{{ routes.search_url }}" method="get" class="zo-search" role="search">
      <label class="visually-hidden" for="ZoSearch-{{ section.id }}">Search products</label>
      <input id="ZoSearch-{{ section.id }}" type="search" name="q" placeholder="Search frames, sunglasses, lenses" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last">
      <button class="zo-icon-button" aria-label="Search" title="Search" type="submit">{% render 'zaman-premium-icon', icon: 'search', size: 21 %}</button>
    </form>
    {% if shop.customer_accounts_enabled %}<a class="zo-icon-button zo-account" href="{{ routes.account_url }}" aria-label="Account" title="Account">{% render 'zaman-premium-icon', icon: 'account', size: 23 %}</a>{% endif %}
    <a class="zo-icon-button zo-cart" href="{{ routes.cart_url }}" aria-label="Cart" title="Cart">{% render 'zaman-premium-icon', icon: 'cart', size: 23 %}<span data-zo-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></a>
  </div>
</header>
<dialog id="ZoMenu" class="zo-drawer" aria-labelledby="ZoMenuTitle">
  <div class="zo-drawer__head"><h2 id="ZoMenuTitle">Explore Zaman Optics</h2><button class="zo-icon-button" type="button" data-zo-close aria-label="Close menu" autofocus>{% render 'zaman-premium-icon', icon: 'close', size: 22 %}</button></div>
  <form action="{{ routes.search_url }}" method="get" class="zo-search" role="search">
    <label class="visually-hidden" for="ZoDrawerSearch">Search products</label><input id="ZoDrawerSearch" type="search" name="q" placeholder="What are you looking for?">
    <input type="hidden" name="type" value="product"><button type="submit" class="zo-icon-button" aria-label="Search">{% render 'zaman-premium-icon', icon: 'search', size: 20 %}</button>
  </form>
  <nav aria-label="Full store menu">
    {% assign audiences = 'Men,Women' | split: ',' %}
    {% for audience in audiences %}
      <details class="zo-drawer__group"><summary>{{ audience }} {% render 'zaman-premium-icon', icon: 'chevron-down', size: 16 %}</summary>
        <div class="zo-drawer__links">
          {% assign audience_tag = 'Gender: ' | append: audience | handleize %}
          <a href="{{ collections.eyeglasses.url }}/{{ audience_tag }}">Eyeglasses</a>
          <a href="{{ collections.sunglasses.url }}/{{ audience_tag }}">Sunglasses</a>
          <a href="{{ collections.eyeglasses.url }}/gender-unisex">Unisex eyeglasses</a>
          <a href="{{ collections.sunglasses.url }}/gender-unisex">Unisex sunglasses</a>
        </div>
      </details>
    {% endfor %}
    <a class="zo-drawer__direct" href="{{ collections['kids-glasses'].url }}">Kids Glasses {% render 'zaman-premium-icon', icon: 'arrow-right', size: 16 %}</a>
    <details class="zo-drawer__group"><summary>Contact Lenses {% render 'zaman-premium-icon', icon: 'chevron-down', size: 16 %}</summary>
      <div class="zo-drawer__links">
        <a href="{{ routes.collections_url }}/contact-lenses">All contact lenses</a>
        <a href="{{ routes.collections_url }}/contact-lenses/lens-type-power">Power lenses</a>
        <a href="{{ routes.collections_url }}/contact-lenses/lens-type-toric">Toric lenses</a>
        <a href="{{ routes.collections_url }}/contact-lenses/lens-type-fashion">Fashion lenses</a>
      </div>
    </details>
    <details open class="zo-drawer__group"><summary>Shop eyewear {% render 'zaman-premium-icon', icon: 'chevron-down', size: 16 %}</summary><div class="zo-drawer__links">{% render 'zaman-shop-links' %}<a href="{{ routes.all_products_collection_url }}">All Products</a><a href="{{ routes.collections_url }}">All Collections</a></div></details>
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <details class="zo-drawer__group"><summary>{{ link.title | escape }} {% render 'zaman-premium-icon', icon: 'chevron-down', size: 16 %}</summary><div class="zo-drawer__links"><a href="{{ link.url }}">View all {{ link.title | escape }}</a>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="zo-drawer__nested" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</div></details>
        {% endif %}
      {% endfor %}
    {% endif %}
    <details class="zo-drawer__group" open><summary>Guides &amp; support {% render 'zaman-premium-icon', icon: 'chevron-down', size: 16 %}</summary><div class="zo-drawer__links">{% render 'zaman-help-links' %}<a href="/pages/contact">Contact our team</a>{% if pages.about != blank %}<a href="{{ pages.about.url }}">About Zaman Optics</a>{% endif %}{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">My account</a>{% endif %}</div></details>
  </nav>
  <p class="zo-drawer__foot">Your local optical store in Gujar Khan.</p>
</dialog>
{% schema %}
{
  "name": "Header",
  "settings": [
    {"type": "image_picker", "id": "logo", "label": "Logo"},
    {"type": "text", "id": "announcement", "label": "Announcement", "default": "Eyewear for everyday life. Optical support from Gujar Khan."},
    {"type": "link_list", "id": "menu", "label": "Additional grouped drawer links", "default": "main-menu", "info": "Nested menu groups appear below Shop eyewear."}
  ]
}
{% endschema %}
