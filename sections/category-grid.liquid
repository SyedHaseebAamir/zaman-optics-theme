<section class="zo-section zo-container">
  <div class="zo-section-heading"><div><p class="zo-eyebrow">Find your next pair</p><h2>{{ section.settings.section_title | default: 'Shop by category' | escape }}</h2><p>Everyday frames, sunny-day favourites, and lens options for your routine.</p></div><a class="zo-text-link" href="{{ routes.collections_url }}">All collections {% render 'zaman-premium-icon', icon: 'arrow-right', size: 16 %}</a></div>
  <div class="zo-categories">
    {% assign handles = 'eyeglasses,sunglasses,blue-light-glasses,kids-glasses,contact-lenses' | split: ',' %}
    {% assign image_keys = 'eyeglasses_image,sunglasses_image,bluelight_image,kids_image,contacts_image' | split: ',' %}
    {% for handle in handles %}
      {% assign catalog = collections[handle] %}
      {% if catalog != blank and catalog.all_products_count > 0 %}
        {% assign image_key = image_keys[forloop.index0] %}
        {% assign category_image = section.settings[image_key] | default: catalog.image | default: catalog.products.first.featured_image %}
        <a class="zo-category" href="{{ catalog.url }}">
          <div class="zo-category__image">{% if category_image %}{{ category_image | image_url: width: 720 | image_tag: widths: '240, 400, 720', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: catalog.title }}{% else %}<div class="zo-product__placeholder">{% render 'zaman-premium-icon', icon: 'glasses', size: 42 %}</div>{% endif %}</div>
          <div class="zo-category__label"><h3>{% if handle == 'blue-light-glasses' %}Blue Screen Glasses{% else %}{{ catalog.title | escape }}{% endif %}</h3>{% render 'zaman-premium-icon', icon: 'arrow-right', size: 17 %}</div>
          <p>{{ catalog.all_products_count }} {% if catalog.all_products_count == 1 %}style{% else %}styles{% endif %} to explore</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {"type":"text","id":"section_title","label":"Heading","default":"Shop by category"},
    {"type":"image_picker","id":"eyeglasses_image","label":"Eyeglasses image"},
    {"type":"image_picker","id":"sunglasses_image","label":"Sunglasses image"},
    {"type":"image_picker","id":"bluelight_image","label":"Blue screen glasses image"},
    {"type":"image_picker","id":"kids_image","label":"Kids image"},
    {"type":"image_picker","id":"contacts_image","label":"Contact lenses image"}
  ],
  "presets":[{"name":"Shop by category"}]
}
{% endschema %}
